<div class="dark-heresy-v1 chat-card weapon-attack {{#if success}}success{{else}}failure{{/if}}">
  <h3 class="card-title">{{label}}</h3>
  <p>{{localize "DH.Roll.Target"}} : {{target}}{{#if modifier}} ({{modifier}}){{/if}}</p>
  <p>{{localize "DH.Roll.Result"}} : {{result}}</p>
  <p class="outcome">
    {{#if success}}{{localize "DH.Roll.Success"}}{{else}}{{localize "DH.Roll.Failure"}}{{/if}}
    — {{localize "DH.Roll.Degree"}} {{degree}}
  </p>
  {{#if success}}
    <p>{{localize "DH.Attack.Location"}} : {{locationLabel}}</p>
    <p>{{localize "DH.Attack.DamageType"}} : {{damageTypeLabel}}</p>
    <button type="button" class="weapon-damage-roll" data-actor-id="{{actorId}}" data-item-id="{{itemId}}">
      {{localize "DH.Attack.RollDamage"}}
    </button>
  {{/if}}
</div>
