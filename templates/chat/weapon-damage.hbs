<div class="dark-heresy-v1 chat-card weapon-damage">
  <h3 class="card-title">{{label}}</h3>
  {{#if attributes}}<p class="weapon-attributes">{{localize "DH.Weapon.Attributes"}} : {{attributes}}</p>{{/if}}
  <p>{{localize "DH.Attack.DamageType"}} : {{damageTypeLabel}}</p>
  <p>{{localize "DH.Attack.Penetration"}} : {{penetration}}</p>
  <div class="damage-breakdown">
    {{#each breakdown as |part|}}
      <span class="damage-part {{#unless part.active}}discarded{{/unless}} {{#if part.isDie}}die{{else}}flat{{/if}} {{#if part.isTen}}fury-ten{{/if}}">
        {{#if (eq part.sign -1)}}−{{else}}+{{/if}}{{part.display}}
      </span>
    {{/each}}
  </div>
  {{#if forceBonus}}<p>{{localize "DH.Attack.ForceBonus"}} : +{{forceBonus}}</p>{{/if}}
  <p class="outcome">{{localize "DH.Attack.Total"}} : {{total}}</p>
  {{#if furyAvailable}}
    <button type="button" class="righteous-fury-roll" data-actor-id="{{actorId}}" data-item-id="{{itemId}}" data-base-total="{{total}}">
      <i class="fa-solid fa-burst"></i> {{localize "DH.RighteousFury.Roll"}}
    </button>
  {{/if}}
</div>
