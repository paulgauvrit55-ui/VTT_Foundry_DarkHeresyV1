<div class="talent-body">
  <header class="sheet-header">
    <h1 class="itemname">
      <input name="name" type="text" value="{{item.name}}">
    </h1>
  </header>

  <div class="form-group">
    <label>{{localize "DH.Talent.Prerequisites"}}</label>
    <input type="text" name="system.prerequisites" value="{{system.prerequisites}}">
  </div>

  <div class="form-group stacked">
    <label>{{localize "DH.Talent.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
