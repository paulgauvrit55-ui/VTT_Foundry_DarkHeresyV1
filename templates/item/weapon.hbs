<div class="weapon-body">
  <header class="sheet-header">
    <h1 class="itemname">
      <input name="name" type="text" value="{{item.name}}">
    </h1>
  </header>

  <div class="form-group">
    <label>{{localize "DH.Weapon.DamageFormula"}}</label>
    <input type="text" name="system.damageFormula" value="{{system.damageFormula}}">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Weapon.DamageType"}}</label>
    <select name="system.damageType">
      {{#each damageTypes as |type|}}
        <option value="{{type.key}}" {{#if type.selected}}selected{{/if}}>{{type.label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize "DH.Weapon.Penetration"}}</label>
    <input type="number" name="system.penetration" value="{{system.penetration}}">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Weapon.Bonus"}}</label>
    <input type="number" name="system.bonus" value="{{system.bonus}}">
  </div>

  <div class="form-group stacked">
    <label>{{localize "DH.Weapon.Attributes"}}</label>
    <input type="text" name="system.attributes" value="{{system.attributes}}">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Gear.Weight"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" step="0.1">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Gear.Price"}}</label>
    <input type="number" name="system.price" value="{{system.price}}">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Gear.Availability"}}</label>
    <input type="text" name="system.availability" value="{{system.availability}}">
  </div>

  <div class="form-group stacked">
    <label>{{localize "DH.Gear.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
