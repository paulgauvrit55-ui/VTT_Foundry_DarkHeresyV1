<div class="gear-body">
  <header class="sheet-header">
    <h1 class="itemname">
      <input name="name" type="text" value="{{item.name}}">
    </h1>
  </header>

  <div class="form-group">
    <label>{{localize "DH.Gear.Weight"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" step="0.1">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Gear.Price"}}</label>
    <input type="number" name="system.price" value="{{system.price}}">
  </div>

  <div class="form-group">
    <label>{{localize "DH.Gear.Availability"}}</label>
    <input type="text" name="system.availability" value="{{system.availability}}">
  </div>

  <div class="form-group stacked">
    <label>{{localize "DH.Gear.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
